# Dashboard → Project Settings → API Keys → Publishable key.
# Bentuknya sb_publishable_... Kunci ini pengganti anon key untuk aplikasi di browser.
# Session pooler (postgresql://...pooler.supabase.com:5432) berisi password database.
# Jangan menaruh string itu di file ini, karena Vite menyertakannya ke aplikasi yang terpasang di ponsel.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
